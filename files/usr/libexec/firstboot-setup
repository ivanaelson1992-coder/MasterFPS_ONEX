#!/bin/bash
set -euo pipefail

# Gera locale
locale-gen
localectl set-locale LANG=pt_BR.UTF-8
localectl set-keymap br-abnt2
timedatectl set-timezone America/Sao_Paulo

# Habilita multilib (Steam 32-bit)
sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' /etc/pacman.conf
pacman -Sy --noconfirm

# Atualiza tudo
pacman -Syu --noconfirm

# Confiar arquivos .desktop do usuário gaming
for f in /home/gaming/Desktop/*.desktop; do
    [ -f "$f" ] && gio set "$f" metadata::trusted true 2>/dev/null || true
done

# Aplicar power profile performance
powerprofilesctl set performance 2>/dev/null || true

# Configurar cursor grande para o usuário gaming
mkdir -p /home/gaming/.config/gtk-3.0
cat > /home/gaming/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-cursor-theme-name=breeze_cursors
gtk-cursor-theme-size=48
EOF

mkdir -p /home/gaming/.config/gtk-4.0
cat > /home/gaming/.config/gtk-4.0/settings.ini <<'EOF'
[Settings]
gtk-cursor-theme-name=breeze_cursors
gtk-cursor-theme-size=48
EOF

# Variáveis de ambiente do cursor
mkdir -p /home/gaming/.config/environment.d
cat > /home/gaming/.config/environment.d/99-cursor.conf <<'EOF'
XCURSOR_SIZE=48
XCURSOR_THEME=breeze_cursors
WAYLAND_CURSOR_SIZE=48
WAYLAND_CURSOR_THEME=breeze_cursors
EOF

chown -R gaming:gaming /home/gaming/.config

# Marca firstboot concluído
touch /etc/.firstboot_done

# Reboot se necessário
systemctl reboot