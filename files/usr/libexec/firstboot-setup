#!/bin/bash
set -euo pipefail

# Criar grupos necessários se não existirem
for grp in wheel video audio input; do
    getent group "$grp" >/dev/null || groupadd -r "$grp"
done

# Criar usuario gamer se não existir
if ! id gamer >/dev/null 2>&1; then
    useradd -m -G wheel,video,audio,input -s /bin/bash gamer
    echo "gamer:gamer" | chpasswd
    echo "gamer ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/gamer
fi

# Gera locale
locale-gen
localectl set-locale LANG=pt_BR.UTF-8
localectl set-keymap br-abnt2
timedatectl set-timezone America/Sao_Paulo

# Habilita multilib (Steam 32-bit)
sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' /etc/pacman.conf
pacman -Sy --noconfirm

# Atualiza tudo
pacman -Syu --noconfirm

# Configurar flatpak e flathub
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

# Instalar apps flatpak necessarios
flatpak install -y flathub com.valvesoftware.Steam
flatpak install -y flathub org.mozilla.firefox
flatpak install -y flathub com.visualstudio.code

# Confiar arquivos .desktop do usuario gamer
for f in /home/gamer/Desktop/*.desktop; do
    [ -f "$f" ] && gio set "$f" metadata::trusted true 2>/dev/null || true
done

# Aplicar power profile performance
powerprofilesctl set performance 2>/dev/null || true

# Configurar cursor grande para o usuario gamer
mkdir -p /home/gamer/.config/gtk-3.0
cat > /home/gamer/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-cursor-theme-name=breeze_cursors
gtk-cursor-theme-size=48
EOF

mkdir -p /home/gamer/.config/gtk-4.0
cat > /home/gamer/.config/gtk-4.0/settings.ini <<'EOF'
[Settings]
gtk-cursor-theme-name=breeze_cursors
gtk-cursor-theme-size=48
EOF

# Variaveis de ambiente do cursor
mkdir -p /home/gamer/.config/environment.d
cat > /home/gamer/.config/environment.d/99-cursor.conf <<'EOF'
XCURSOR_SIZE=48
XCURSOR_THEME=breeze_cursors
WAYLAND_CURSOR_SIZE=48
WAYLAND_CURSOR_THEME=breeze_cursors
EOF

chown -R gamer:gamer /home/gamer/.config
chown -R gamer:gamer /home/gamer

# Marca firstboot concluido
touch /etc/.firstboot_done

# Reboot se necessario
systemctl reboot