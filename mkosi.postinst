#!/bin/bash
set -e

# Habilitar servicos basicos
systemctl enable lightdm NetworkManager firstboot.service || true

# Configurar autologin para lightdm (usuario sera criado no firstboot)
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/autologin.conf <<'EOF'
[Seat:*]
autologin-user=gamer
autologin-user-timeout=0
EOF