#!/bin/bash
set -euo pipefail

# 1. Enable services
systemctl enable \
  systemd-timesyncd \
  systemd-resolved \
  NetworkManager \
  bluetooth \
  sshd || true

# 2. Add gaming user
useradd -m -G wheel,video,input,render,audio -s /bin/bash gaming || true
echo "gaming:gaming" | chpasswd
echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/wheel

# 3. Create desktop shortcuts for user
mkdir -p /etc/skel/Desktop
mkdir -p /home/gaming/Desktop

# Ensure desktop files exist in /home/gaming/Desktop
cp -r /etc/skel/Desktop/* /home/gaming/Desktop/ 2>/dev/null || true
chown -R gaming:gaming /home/gaming || true

# 4. Auto-login on TTY1
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/override.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --autologin gaming --noclear %I $TERM
EOF

# 5. NVIDIA DRM KMS
mkdir -p /etc/modules-load.d
echo -e "nvidia\nnvidia_modeset\nnvidia_uvm\nnvidia_drm" > /etc/modules-load.d/nvidia.conf

# 6. MangoHud & GameMode defaults
mkdir -p /etc/mangohud
cat > /etc/mangohud/mangohud.conf <<'EOF'
gpu_stats
cpu_stats
ram
vram
fps_limit=0
frame_timing=1
gpu_color=FF00FF
cpu_color=00FFFF
ram_color=FFFF00
vram_color=FF8800
font_size=24
position=top-left
EOF

mkdir -p /etc/gamemode
cat > /etc/gamemode/gamemode.ini <<'EOF'
[general]
renice=10
ioprio=0
inhibit_screensaver=1
gpu_optimisations=1

[cpu]
governor=performance
min_perf_pct=100

[gpu]
allow_gpu_optimisations=1
nvidia_perf_level=maximum
EOF

# 7. Cursor Size (48px)
mkdir -p /etc/environment.d
cat > /etc/environment.d/99-cursor.conf <<'EOF'
XCURSOR_SIZE=48
XCURSOR_THEME=breeze_cursors
WAYLAND_CURSOR_SIZE=48
WAYLAND_CURSOR_THEME=breeze_cursors
EOF

# Clean pacman cache
pacman -Sc --noconfirm || true
