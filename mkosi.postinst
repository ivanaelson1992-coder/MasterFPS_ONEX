#!/bin/bash
set -e

useradd -m -G wheel,video,audio,input -s /bin/bash gamer || true
echo "gamer:gamer" | chpasswd
echo "gamer ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/gamer

mkdir -p /etc/lightdm/lightdm.conf.d /usr/share/themes /home/gamer/Desktop /usr/share/applications /home/gamer/.config/autostart

cat << 'EOL' > /etc/lightdm/lightdm.conf.d/10-autologin.conf
[Seat:*]
autologin-user=gamer
autologin-user-timeout=0
user-session=xfce
EOL

cat << 'EOL' > /etc/lightdm/lightdm-gtk-greeter.conf
[greeter]
background=/usr/share/backgrounds/masterfps-fenix.png
EOL

git clone --depth=1 https://github.com /usr/share/themes/Windows-7 || true

cat << 'EOD' > /usr/share/applications/master-gamer.desktop
[Desktop Entry]
Name=Master Gamer
Exec=/usr/local/bin/master-gamer
Icon=utilities-system-monitor
Terminal=false
Type=Application
EOD
cp /usr/share/applications/master-gamer.desktop /home/gamer/Desktop/
chmod +x /home/gamer/Desktop/master-gamer.desktop

cat << 'EON' > /home/gamer/.config/autostart/nexo-os.desktop
[Desktop Entry]
Type=Application
Name=Nexo OS
Exec=/opt/nexo-os/start.sh
X-GNOME-Autostart-enabled=true
EON

cat << 'EOF' > /usr/local/bin/masterfps-firstboot.sh
#!/bin/bash
systemctl enable --now NetworkManager systemd-zram-setup@zram0.service || true
su - gamer -c "DISPLAY=:0 xfconf-query -c xsettings -p /Net/ThemeName -s Windows-7" || true
su - gamer -c "DISPLAY=:0 xfconf-query -c xfwm4 -p /general/theme -s Windows-7" || true
su - gamer -c "DISPLAY=:0 xfconf-query -c xfwm4 -p /general/use_compositing -s false" || true
su - gamer -c "DISPLAY=:0 xfconf-query -c xfce4-panel -p /panels/panel-1/size -s 40" || true
su - gamer -c "DISPLAY=:0 xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image -s /usr/share/backgrounds/masterfps-fenix.png" || true
flatpak remote-add --if-not-exists flathub https://flathub.org || true
if [ -f /etc/masterfps/flatpak.txt ]; then
    while read -r app; do [ -n "$app" ] && flatpak install -y flathub "$app" || true; done < /etc/masterfps/flatpak.txt
fi
systemctl disable firstboot.service || true
EOF
chmod +x /usr/local/bin/masterfps-firstboot.sh

cat << 'EOF' > /etc/os-release
NAME="MasterFPS"
PRETTY_NAME="MasterFPS Gaming OS"
ID=masterfps
ID_LIKE=arch
BUILD_ID=rolling
EOF

systemctl enable lightdm NetworkManager firstboot.service || true
chown -R gamer:gamer /home/gamer