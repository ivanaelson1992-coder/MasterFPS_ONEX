#!/bin/bash
set -e

# Enable NetworkManager
systemctl enable NetworkManager || true

# Install systemd-boot to the ESP partition
# The ESP is typically mounted at /boot or /efi during the install phase
# We need to find it and install systemd-boot there

echo "Installing systemd-boot to EFI System Partition..."

# Check if systemd-boot is installed
if command -v bootctl &> /dev/null; then
    # Try to install systemd-boot
    bootctl install --esp-path=/boot/efi --boot-path=/boot 2>/dev/null || \
    bootctl install --esp-path=/boot --boot-path=/boot 2>/dev/null || \
    bootctl install 2>/dev/null || true
    
    echo "systemd-boot installation attempted"
else
    echo "bootctl not found, skipping systemd-boot installation"
fi

# Create default systemd-boot entry
if [ -f "/boot/loader/entries/masterfps.conf" ] || [ -f "/boot/efi/loader/entries/masterfps.conf" ]; then
    echo "systemd-boot entry already exists"
elif [ -d "/boot" ] || [ -d "/boot/efi" ]; then
    mkdir -p /boot/loader/entries
    mkdir -p /boot/efi/loader/entries
    
    # Create a basic boot entry
    cat > /boot/loader/entries/masterfps.conf << 'EOF'
title    MasterFPS
linux    /vmlinuz-linux-zen
initrd   /initramfs-linux-zen.img
options  root=PARTUUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx rw
EOF
    
    cat > /boot/efi/loader/entries/masterfps.conf << 'EOF'
title    MasterFPS
EOF
    
    # Create loader.conf
    echo "default masterfps.conf" > /boot/loader/loader.conf
    echo "default masterfps.conf" > /boot/efi/loader/loader.conf
fi

echo "Post-install script completed successfully"