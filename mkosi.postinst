#!/bin/bash
set -e

mkdir -p "$BUILDROOT/etc/sudoers.d" "$BUILDROOT/etc/lightdm/lightdm.conf.d" "$BUILDROOT/usr/share/themes" "$BUILDROOT/usr/share/applications" "$BUILDROOT/usr/local/bin"

chroot "$BUILDROOT" groupadd -f wheel
chroot "$BUILDROOT" groupadd -f input
chroot "$BUILDROOT" groupadd -f sudo
chroot "$BUILDROOT" useradd -m -G wheel,sudo,video,audio,input -s /bin/bash gamer 2>/dev/null || chroot "$BUILDROOT" useradd -m -s /bin/bash gamer || true

HASH='$6$rounds=4096$masterfps$8W7z/uQ5y/5t9q.P.M5N1rE6E9W1F3B607488DB35A47'
chroot "$BUILDROOT" usermod -p "$HASH" gamer 2>/dev/null || true

echo "gamer ALL=(ALL) NOPASSWD: ALL" > "$BUILDROOT/etc/sudoers.d/gamer"
chmod 0440 "$BUILDROOT/etc/sudoers.d/gamer"

cat << 'EOL' > "$BUILDROOT/etc/lightdm/lightdm.conf.d/10-autologin.conf"
[Seat:*]
autologin-user=gamer
autologin-user-timeout=0
user-session=xfce
EOL

cat << 'EOL' > "$BUILDROOT/etc/lightdm/lightdm-gtk-greeter.conf"
[greeter]
background=/usr/share/backgrounds/masterfps-fenix.png
EOL

git clone --depth=1 https://github.com "$BUILDROOT/usr/share/themes/Windows-7" 2>/dev/null || true

mkdir -p "$BUILDROOT/home/gamer/Desktop" "$BUILDROOT/home/gamer/.config/autostart"
cat << 'EOD' > "$BUILDROOT/usr/share/applications/master-gamer.desktop"
[Desktop Entry]
Name=Master Gamer
Exec=/usr/local/bin/master-gamer
Icon=utilities-system-monitor
Terminal=false
Type=Application
EOD
cp "$BUILDROOT/usr/share/applications/master-gamer.desktop" "$BUILDROOT/home/gamer/Desktop/"
chmod +x "$BUILDROOT/home/gamer/Desktop/master-gamer.desktop"

cat << 'EON' > "$BUILDROOT/home/gamer/.config/autostart/nexo-os.desktop"
[Desktop Entry]
Type=Application
Name=Nexo OS
Exec=/opt/nexo-os/start.sh
X-GNOME-Autostart-enabled=true
EON

cat << 'EOF' > "$BUILDROOT/usr/local/bin/masterfps-firstboot.sh"
#!/bin/bash
systemctl enable --now NetworkManager systemd-zram-setup@zram0.service || true
su - gamer -c "DISPLAY=:0 xfconf-query -c xsettings -p /Net/ThemeName -s Windows-7" || true
su - gamer -c "DISPLAY=:0 xfconf-query -c xfwm4 -p /general/theme -s Windows-7" || true
su - gamer -c "DISPLAY=:0 xfconf-query -c xfwm4 -p /general/use_compositing -s false" || true
su - gamer -c "DISPLAY=:0 xfconf-query -c xfce4-panel -p /panels/panel-1/size -s 40" || true
su - gamer -c "DISPLAY=:0 xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image -s /usr/share/backgrounds/masterfps-fenix.png" || true
flatpak remote-add --if-not-exists flathub https://flathub.org || true
if [ -f /etc/masterfps/flatpak.txt ]; then
    while read -r app; do [ -n "$app" ] && flatpak install -y flathub "$app" || true; done < /etc/masterfps/flatpak.txt
fi
systemctl disable firstboot.service || true
EOF
chmod +x "$BUILDROOT/usr/local/bin/masterfps-firstboot.sh"

cat << 'EOF' > "$BUILDROOT/etc/os-release"
NAME="MasterFPS"
PRETTY_NAME="MasterFPS Gaming OS"
ID=masterfps
ID_LIKE=arch
BUILD_ID=rolling
EOF

chroot "$BUILDROOT" systemctl enable lightdm NetworkManager firstboot.service 2>/dev/null || true
chroot "$BUILDROOT" chown -R gamer:gamer /home/gamer 2>/dev/null || true