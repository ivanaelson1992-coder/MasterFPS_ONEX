[Distribution]
Distribution=arch
Architecture=x86-64
Repositories=core,extra,multilib

[Output]
Format=disk
Output=MasterFPS-x86_64.raw
OutputDirectory=out
CompressOutput=zstd

[Content]
Bootable=yes
Bootloader=systemd-boot
UnifiedKernelImages=no
Hostname=masterfps
Timezone=America/Fortaleza
Locale=pt_BR.UTF-8
Keymap=br-abnt2
RootPassword=gamer
SkeletonTrees=files

Packages=
    base
    linux-zen
    linux-zen-headers
    linux-firmware
    amd-ucode
    intel-ucode
    systemd
    networkmanager
    zram-generator
    sudo
    bluez
    bluez-utils
    blueman
    nano
    bash-completion
    xorg-server
    xorg-xinit
    xfce4
    xfce4-whiskermenu-plugin
    lightdm
    lightdm-gtk-greeter
    python
    python-pyqt6
    python-pillow
    python-psutil
    flatpak
    ttf-liberation
    noto-fonts
    gvfs
    ntfs-3g
    git
    gamemode
    lib32-gamemode
    mangohud
    lib32-mangohud
    gamescope
    wine-staging
    winetricks
    lutris
    steam
    mesa
    lib32-mesa
    vulkan-radeon
    lib32-vulkan-radeon
    vulkan-intel
    lib32-vulkan-intel
    vulkan-icd-loader
    lib32-vulkan-icd-loader
    xf86-video-amdgpu
    xf86-video-intel
    pipewire
    pipewire-alsa
    pipewire-pulse
    pipewire-jack
    wireplumber
    foot
    breeze-gtk
    kitty-terminfo
    nvidia-dkms
    nvidia-utils
    lib32-nvidia-utils
    nvidia-settings
    power-profiles-daemon
    breeze-cursors
    adwaita-cursors
    xcursor-themes
    gnome-themes-extra
    kvantum-qt5
    kvantum-qt6