[Distribution]
Distribution=arch
Release=rolling

[Output]
Format=iso
Output=MasterFPS.iso
Bootable=yes

[Content]
Packages=
  base linux-cachyos linux-firmware base-devel git wget curl zstd
  networkmanager bluez bluez-utils pipewire pipewire-pulse alsa-utils
  sudo vim nano htop btop fastfetch sddm foot flatpak
  mesa lib32-mesa vulkan-radeon vulkan-intel intel-ucode
  nvidia-dkms nvidia-utils lib32-nvidia-utils nvidia-settings libva-nvidia-driver
  steam-native-runtime gamescope mangohud gamemode
  breeze-icons power-profiles-daemon cpupower ananicy-cpp tuned

WithNetwork=yes
Locale=pt_BR.UTF-8
Timezone=America/Sao_Paulo
Hostname=master-fps
